# Salin file ini menjadi .env di folder yang sama (src/backend/.env)
# Jangan commit file .env berisi secret ke Git.

# --- Discord Bot (wajib untuk main.py) ---
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# --- DeepSeek API (wajib untuk main.py, eval_agents.py, eval_rag.py) ---
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# --- Google Cloud (wajib) ---
GCP_PROJECT_ID=your-gcp-project-id
# Lokasi Discovery Engine. Default: global
GCP_LOCATION=global
# Opsional, untuk server/CI dengan service account JSON
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json

# --- Channel filter (opsional, kosongkan = semua channel/DM) ---
# Disarankan pakai ID karena nama bisa berubah/duplikat
ALLOWED_CHANNEL_NAME=maintenance
# ALLOWED_CHANNEL_ID=123456789012345678

# --- Evaluasi (opsional) ---
# Direktori output CSV/JSON eval_agents.py dan eval_rag.py
# EVAL_OUTPUT_DIR=..\..\public

# --- Legacy (opsional, tidak dibaca kode multi-agent saat ini) ---
# Data store kini dikonfigurasi di config/agents_registry.yaml
# DATA_STORE_ID=fmea-data_1789894369425
