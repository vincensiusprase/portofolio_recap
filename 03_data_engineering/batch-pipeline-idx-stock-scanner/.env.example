# Environment variables for Stock Scanner
# Copy this file to .env and fill in your values
# DO NOT commit .env to git

# Google Cloud Project ID
GCP_PROJECT_ID=your-gcp-project-id

# BigQuery Dataset ID
BQ_DATASET_ID=your-bq-dataset-id

# BigQuery Table Name
BQ_TABLE_NAME=your-bq-table-name

# Optional: Service Account JSON key (single line, no newlines)
# Use this if not using Application Default Credentials (ADC)
# GCP_SA_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}